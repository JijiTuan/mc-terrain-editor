node_modules/
dist/
.smoke/
.env
.env.local
.DS_Store
*.log

# 打包产物
# 注意：这个列表要**跟着涨**。前面的目录被删不掉的 default_app.asar 占着，
# pickOutDir() 会自动顺延到 releaseN，每打包一次就可能多一个。
# 与其逐个列，不如按模式忽略 —— 但要排除真正想跟踪的东西（这里没有），
# 所以用 release[0-9]* 一次性覆盖。
release/
release[0-9]*/
build/

# 交付用安装包的副本（154 MB × N 个版本）。
# 这些是从 releaseN/ 复制出来的、方便用户直接找到的成品，
# 二进制产物不进仓库 —— 要发版就走 GitHub Releases。
installer-*/

# Electron 探针留下的临时文件（自检脚本会自己清理，这里兜底）
.electron-verify*
.diag-*

# 打包工具的目录重命名探针。
# 这些是当时排查「release/ 里的 default_app.asar 删不掉」时建的实验目录，
# 每个都塞着一整份解压好的 Electron（.rename-probe2 = 537 MB）。
# 一共 1.3 GB，纯垃圾，绝不能进仓库。
.rename-probe*/
.rp[0-9]*/
.run-probe.mjs

# WorkBuddy 平台留下的应用描述文件，不是源码
.wbapp_*.genie

# 从 Minecraft 客户端提取的贴图源素材。
# 这些是 Mojang 的版权内容，不进仓库；需要时用
#   node tools/build-textures.mjs --zip <材质包.zip>
# 重新生成 src/assets/blocks-atlas.*
.mc-jar-textures/
.mc-textures-tmp/
.mc-data-tmp/
